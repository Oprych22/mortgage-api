{
  "ConnectionStrings": {
    "Mortgage": "Data Source=mortgage.db"
  },
  "Auth": {
    "Issuer": "mortgage-api",
    "Audience": "mortgage-api"
  },
  "Affordability": {
    "MaxLtv": 0.90,
    "MaxDti": 0.50,
    "MaxIncomeMultiple": 4.5,
    "StressRate": 0.07
  },
  "Assessments": {
    "WorkerDelaySeconds": 0
  },
  "Logging": {
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": { "IncludeScopes": true }
    },
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.AspNetCore.HttpLogging.HttpLoggingMiddleware": "Information"
    }
  },
  "AllowedHosts": "*"
}
